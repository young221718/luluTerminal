diff --git a/Sources/GhosttyTerminal/Platform/AppKit/TerminalDropPaste.swift b/Sources/GhosttyTerminal/Platform/AppKit/TerminalDropPaste.swift
new file mode 100644
index 0000000..3f7e98e
--- /dev/null
+++ b/Sources/GhosttyTerminal/Platform/AppKit/TerminalDropPaste.swift
@@ -0,0 +1,21 @@
+#if !canImport(UIKit) && canImport(AppKit)
+    import Foundation
+
+    /// Drop text bypasses libghostty's clipboard paste protection.
+    @MainActor
+    enum TerminalDropPaste {
+        static func deliver(
+            _ text: String,
+            requestConfirmation: (TerminalClipboardConfirmationRequest) -> Void,
+            paste: @escaping (String) -> Bool,
+        ) -> Bool {
+            guard text.utf8.contains(0x0A) || text.utf8.contains(0x0D) || text.contains("\u{1B}[201~") else {
+                return paste(text)
+            }
+            requestConfirmation(TerminalClipboardConfirmationRequest(contents: text, kind: .paste) { allowed in
+                if allowed { _ = paste(text) }
+            })
+            return true
+        }
+    }
+#endif
diff --git a/Tests/GhosttyKitTest/Clipboard/TerminalDropPasteTests.swift b/Tests/GhosttyKitTest/Clipboard/TerminalDropPasteTests.swift
new file mode 100644
index 0000000..910ec34
--- /dev/null
+++ b/Tests/GhosttyKitTest/Clipboard/TerminalDropPasteTests.swift
@@ -0,0 +1,100 @@
+#if !canImport(UIKit) && canImport(AppKit)
+    import AppKit
+    import Foundation
+    @testable import GhosttyTerminal
+    import Testing
+
+    @Suite("TerminalDropPaste", .serialized)
+    @MainActor
+    struct TerminalDropPasteTests {
+        @Test(arguments: ["Worker: 04\nid\n", "first\rsecond", "a\r\nb", "a\u{1B}[201~b", "/tmp/image\nid.png"])
+        func `unsafe drop waits for explicit confirmation and keeps original text`(_ text: String) throws {
+            var request: TerminalClipboardConfirmationRequest?
+            var pasted: [String] = []
+            #expect(TerminalDropPaste.deliver(text, requestConfirmation: { request = $0 }, paste: {
+                pasted.append($0)
+                return true
+            }))
+            #expect(pasted.isEmpty)
+            let pending = try #require(request)
+            #expect(pending.kind == .paste)
+            #expect(Array(pending.contents.utf8) == Array(text.utf8))
+            pending.respond(allow: true)
+            pending.respond(allow: true)
+            #expect(pasted.count == 1)
+            #expect(pasted.first.map { Array($0.utf8) } == Array(text.utf8))
+        }
+
+        @Test
+        func `URL restoration and file paths reach the same confirmation gate`() throws {
+            let view = AppTerminalView(frame: .zero)
+            let inputs: [(String?, [URL])] = [
+                ("Worker: 04\nid\n", [URL(string: "Worker:%2004%0Aid%0A")!]),
+                (nil, [URL(fileURLWithPath: "/tmp/first\nid.txt")]),
+                (nil, [URL(fileURLWithPath: "/tmp/first\rid.txt"), URL(fileURLWithPath: "/tmp/second.txt")]),
+            ]
+            for (string, urls) in inputs {
+                let drag = FakeDrag()
+                defer { drag.release() }
+                drag.pasteboard.writeObjects(urls.map { $0 as NSURL })
+                if let string { drag.pasteboard.setString(string, forType: .string) }
+                guard case let .text(text) = view.dropPayload(from: drag.pasteboard) else {
+                    Issue.record("Missing dropped text")
+                    continue
+                }
+                var request: TerminalClipboardConfirmationRequest?
+                var pasted: [String] = []
+                #expect(TerminalDropPaste.deliver(text, requestConfirmation: { request = $0 }, paste: {
+                    pasted.append($0)
+                    return true
+                }))
+                #expect(pasted.isEmpty)
+                let pending = try #require(request)
+                #expect(Array(pending.contents.utf8) == Array(text.utf8))
+                pending.respond(allow: true)
+                #expect(pasted.first.map { Array($0.utf8) } == Array(text.utf8))
+            }
+        }
+
+        @Test(arguments: TerminalLocalizationTests.languages)
+        func `drop warning and cancel action are translated`(language: String) throws {
+            for key in [
+                "Paste dropped text?",
+                "Text contains line breaks or terminal control sequences. Pasting may run commands.",
+                "Cancel",
+            ] {
+                let value = try TerminalLocalizationTests.translation(of: key, in: language)
+                #expect(value != nil && value != key, "\(language) lacks \(key)")
+            }
+        }
+
+        @Test
+        func `cancel or unanswered confirmation sends no text`() {
+            for answer in [false, nil] as [Bool?] {
+                var request: TerminalClipboardConfirmationRequest?
+                var pasted = false
+                #expect(TerminalDropPaste.deliver("harmless\rid\r", requestConfirmation: { request = $0 }, paste: { _ in
+                    pasted = true
+                    return true
+                }))
+                #expect(!pasted)
+                if let answer { request?.respond(allow: answer) }
+                request = nil
+                #expect(!pasted)
+            }
+        }
+
+        @Test(arguments: ["git status", "한글 e\u{301} 😀", "https://example.com/a%0Ab", "/tmp/drop\\ test.txt"])
+        func `single line bypasses confirmation without modifying text`(_ text: String) {
+            var pasted: [String] = []
+            let result = TerminalDropPaste.deliver(text, requestConfirmation: { _ in
+                Issue.record("Safe drop requested confirmation")
+            }, paste: {
+                pasted.append($0)
+                return false
+            })
+            #expect(!result)
+            #expect(pasted == [text])
+        }
+    }
+#endif
