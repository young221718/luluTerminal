+        private func pasteDroppedText(_ text: String, on surface: TerminalSurface) -> Bool {
+            TerminalDropPaste.deliver(text, requestConfirmation: { [weak self] request in
+                // No modal fallback: an unattached view or another sheet must not approve a drop.
+                guard let window = self?.window, window.attachedSheet == nil else {
+                    request.respond(allow: false)
+                    return
+                }
+                let alert = NSAlert()
+                alert.alertStyle = .warning
+                alert.messageText = String(localized: "Paste dropped text?", bundle: .module)
+                alert.informativeText = String(
+                    localized: "Text contains line breaks or terminal control sequences. Pasting may run commands.",
+                    bundle: .module,
+                )
+                alert.addButton(withTitle: String(localized: "Cancel", bundle: .module)).keyEquivalent = "\r"
+                alert.addButton(withTitle: String(localized: "Paste", bundle: .module)).keyEquivalent = ""
+                alert.beginSheetModal(for: window) { response in
+                    request.respond(allow: response == .alertSecondButtonReturn)
+                }
+            }, paste: { [weak self, weak surface] text in
+                guard let self, let surface, self.surface === surface else { return false }
+                return surface.paste(text: text)
+            })
+        }
