++test "host-managed callbacks preserve bytes and resize" {
++    const Recorder = struct {
++        bytes: [16]u8 = undefined,
++        count: usize = 0,
++        size: [4]u32 = .{ 0, 0, 0, 0 },
++
++        fn write(raw: ?*anyopaque, data: [*]const u8, len: usize) callconv(.c) void {
++            const self: *@This() = @ptrCast(@alignCast(raw.?));
++            @memcpy(self.bytes[0..len], data[0..len]);
++            self.count = len;
++        }
++
++        fn resize(raw: ?*anyopaque, cols: u16, rows: u16, width: u32, height: u32) callconv(.c) void {
++            const self: *@This() = @ptrCast(@alignCast(raw.?));
++            self.size = .{ cols, rows, width, height };
++        }
++    };
++    var recorder: Recorder = .{};
++    var backend = HostManaged.init(.{
++        .userdata = &recorder,
++        .write = Recorder.write,
++        .resize = Recorder.resize,
++    });
++    defer backend.deinit();
++
++    try backend.queueWrite(std.testing.allocator, undefined, "a\x00\r\n", false);
++    try std.testing.expectEqualStrings("a\x00\r\n", recorder.bytes[0..recorder.count]);
++    try backend.queueWrite(std.testing.allocator, undefined, "", false);
++    try std.testing.expectEqual(@as(usize, 4), recorder.count);
++    try backend.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
++    try std.testing.expectEqual([4]u32{ 80, 24, 800, 480 }, recorder.size);
++
++    var no_resize = HostManaged.init(.{ .write = Recorder.write, .userdata = &recorder });
++    defer no_resize.deinit();
++    try no_resize.resize(.{ .columns = 1, .rows = 1 }, .{ .width = 8, .height = 16 });
++}
